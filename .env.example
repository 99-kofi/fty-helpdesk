# Core — zero-dependency local defaults (no Docker, no Postgres/Redis needed).
# SQLite is the default; the app falls back to an in-process queue when Redis is unreachable.
DATABASE_URL=sqlite:///./fty.db
# Optional: point at real Postgres/Redis when you outgrow local dev:
# DATABASE_URL=postgresql+psycopg://fty:fty@localhost:5432/fty_helpdesk
# REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
# Local development only. Leave unset/false in every deployed environment.
ALLOW_DEFAULT_ADMIN_BOOTSTRAP=true
# Production only: create the initial admin on an empty database, then remove
# these values from the deployment environment after the first successful login.
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-unique-password

# Channels (keep secret — never expose to frontend)
META_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me
META_API_VERSION=v21.0
META_APP_ID=
META_PAGE_TOKEN=change-me
META_OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173
TOKEN_ENCRYPTION_KEY=
WHATSAPP_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=

# Outbound email (SMTP) — optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@fty.local
SMTP_USE_TLS=True

# Storage (S3-compatible) — optional. Local dev needs nothing here.
# Set these only when you configure real object storage (e.g. Cloudflare R2 / AWS S3).
# S3_ENDPOINT=
# S3_BUCKET=fty-attachments
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI (plug in later — Phase 4)
OPENAI_API_KEY=
AI_AUTO_REPLY_THRESHOLD=0.95
